    "handler_js": "'use strict';\nconst mocks = require('./mocks.json');\n\nfunction deepEqual(a, b) {\n  if (a === b) return true;\n  if (typeof a !== typeof b || a === null || b === null) return false;\n  if (typeof a !== 'object') return false;\n  const aKeys = Object.keys(a), bKeys = Object.keys(b);\n  if (aKeys.length !== bKeys.length) return false;\n  return aKeys.every((k) => deepEqual(a[k], b[k]));\n}\n\n// Async/return handler required for Node.js 24+.\n// Error mocks throw so Genesys marks Execute as failed. Genesys always wraps\n// Lambda throws as internal.server.error / ACTION.REMOTE_ENDPOINT; the thrown\n// message is what Function-mode validation matches on.\nexports.handle = async (event) => {\n  const match = mocks.cases.find((c) => deepEqual(c.input, event));\n  const successCases = mocks.cases.filter((c) => c.response !== undefined);\n  const chosen = match || mocks.default || successCases[Math.floor(Math.random() * successCases.length)];\n  if (!chosen) throw new Error('NO_MOCKS_REGISTERED');\n  if (chosen.error !== undefined) {\n    const msg = chosen.error.message || chosen.error.code || 'MOCK_ERROR';\n    throw new Error(msg);\n  }\n  return chosen.response;\n};\n",
